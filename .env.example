# --- Local development -------------------------------------------------
# Optional: database filename inside ./data (default: sidfast.db)
SIDFAST_DB=sidfast.db

# Absolute URL of this deployment (used in emails, OAuth redirects, callbacks)
APP_URL=http://localhost:3000
# Secret used to sign OAuth state. Any long random string.
APP_SECRET=change-me-to-a-long-random-string

# --- Database ----------------------------------------------------------
# Leave unset locally to use the SQLite file in ./data.
# Set both to use Turso (required on Vercel — the filesystem is ephemeral).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Email (optional) --------------------------------------------------
# Without a key the app still works: password-reset links are logged instead.
RESEND_API_KEY=
RESEND_FROM=SidFast <onboarding@resend.dev>

# --- Billing: Stripe (optional — pricing page stays hidden without it) --
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# --- Billing: alternative providers (optional) --------------------------
# Endpoint: POST /api/webhooks/polar | /lemonsqueezy | /razorpay | /dodo
POLAR_WEBHOOK_SECRET=
LEMONSQUEEZY_WEBHOOK_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DODO_WEBHOOK_SECRET=

# --- Google Search Console (optional) ----------------------------------
# Redirect URI must be exactly: {APP_URL}/api/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
